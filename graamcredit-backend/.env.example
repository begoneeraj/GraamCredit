# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./graamcredit.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-random-secret-key-change-this

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# To enable emails:
#  1. Go to your Gmail account → Security → 2-Step Verification (must be ON)
#  2. Search "App passwords" → generate one for "Mail" on "Other device"
#  3. Copy the 16-character password (no spaces) into SMTP_PASSWORD below
#  4. Set SMTP_USER to your Gmail address
#  5. Set ADMIN_EMAIL to the inbox that should receive contact notifications
#
# Leave SMTP_USER or SMTP_PASSWORD blank to disable emails (safe for local dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
ADMIN_EMAIL=your-gmail@gmail.com

# ── Account Aggregator (Phase 3) ───────────────────────────────────────────────
# The real Setu AA sandbox requires registered business KYC (GST / incorporation
# docs) that isn't available to individual/student developers, so a mock AA flow
# (routes/account_aggregator.py) is the DEFAULT active path — it simulates the
# full consent + bank-linking + data-fetch flow with realistic synthetic data.
# Leave USE_MOCK_AA=true for demo/dev. Flip to false once business KYC is done
# and the Setu credentials below are filled in — no code rewrite needed.
USE_MOCK_AA=true

# Register at https://setu.co/products/data/account-aggregator
# Sandbox credentials are provided free after registration (business KYC required).
SETU_BASE_URL=https://fiu-uat.setu.co
SETU_CLIENT_ID=your-setu-client-id
SETU_CLIENT_SECRET=your-setu-client-secret
SETU_FIU_ID=your-fiu-id
# Public URL your backend is reachable at (Setu needs this for webhooks)
# For local testing: use ngrok → ngrok http 8000 → paste the https URL here
BACKEND_PUBLIC_URL=https://your-ngrok-or-deployed-url.com
